# ============================================================
#  Chaaye Khana Jhelum — backend environment
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env`. NEVER ship any of these values to the
#  browser / client-side code.
# ============================================================

# --- Server ---
PORT=8787
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (CORS).
# In production set this to your real site origin(s), e.g.
# https://chaayekhana-jhelum.example,https://www.chaayekhana-jhelum.example
CORS_ORIGINS=http://localhost:4173,http://localhost:4175

# --- Anthropic (restaurant AI agent) ---
# Server-side ONLY. The key is read here and never leaves the server.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for the restaurant agent. Default is claude-opus-5.
# For a high-volume public chat widget, claude-haiku-4-5 or
# claude-sonnet-5 are cheaper and fast enough for this scope.
AGENT_MODEL=claude-opus-5

# Reasoning effort for the agent: low | medium | high | xhigh | max
# "low" is appropriate for scoped FAQ-style answers.
AGENT_EFFORT=low

# Max tokens for a single agent reply (answers are short).
AGENT_MAX_TOKENS=800

# --- Chat rate limiting (per client IP) ---
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=15

# --- General API rate limiting (per client IP) ---
API_RATE_WINDOW_MS=60000
API_RATE_MAX=120

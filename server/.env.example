# ============================================================
#  Chaaye Khana Jhelum — backend environment
#  Copy this file to `.env` and fill in real values.
#  NEVER commit `.env`. NEVER ship any of these values to the
#  browser / client-side code.
# ============================================================

# --- Server ---
PORT=8787
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (CORS) AND allowed
# to use the chat. In production set this to your real site origin(s), e.g.
# https://chaaye-khana-jhelum.vercel.app,https://www.chaayekhana-jhelum.com
CORS_ORIGINS=http://localhost:4173,http://localhost:4175

# --- Anthropic (restaurant AI agent) ---
# Server-side ONLY. Read here, never sent to the browser, never logged.
# Use a DEDICATED key for this project and set a spend limit on it in the
# Anthropic Console (Settings -> Limits). That console limit is the one
# protection no code bug can bypass.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model for the agent. Default claude-haiku-4-5 — cheapest, and plenty for a
# scoped FAQ bot answering from verified data. Options and rough cost vs Haiku:
#   claude-haiku-4-5   1x     (default)
#   claude-sonnet-5    ~2x
#   claude-opus-5      ~5x
AGENT_MODEL=claude-haiku-4-5
AGENT_EFFORT=low
AGENT_MAX_TOKENS=600

# --- Hard cost ceilings (the "credits vanish" fix) ---
# When either limit is reached the agent STOPS calling the API until rollover
# (new day / new month) and returns a friendly "on a break" message for free.
# 0 = no limit (not recommended). Estimated USD, tracked in server/.data/spend.json
AGENT_DAILY_USD_LIMIT=1
AGENT_MONTHLY_USD_LIMIT=10

# --- Answer cache (biggest cost saver) ---
# Identical single-turn questions are served from memory for this long — no API
# call. A restaurant chat asks the same few things constantly.
AGENT_CACHE_TTL_MS=900000
AGENT_CACHE_MAX=500

# --- Abuse protection for /api/chat ---
# Only accept chat requests whose Origin/Referer is in CORS_ORIGINS. Blocks most
# scripted / bot abuse (they omit these headers). Set to "false" only if you
# call the chat API from a non-browser client you control.
ENFORCE_CHAT_ORIGIN=true

# Optional shared token the frontend must send as the X-Chat-Token header.
# It ships in the page so it is NOT a secret, but it stops the laziest bots.
# Leave empty to disable.
CHAT_ACCESS_TOKEN=

# --- Rate limits (per client IP unless noted) ---
API_RATE_WINDOW_MS=60000
API_RATE_MAX=120
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX=8
# Global ceiling across ALL callers for /api/chat — catches distributed floods.
CHAT_GLOBAL_WINDOW_MS=60000
CHAT_GLOBAL_MAX=60
